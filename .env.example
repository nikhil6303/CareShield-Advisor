# ==============================================================================
# CareShield Advisor - Environment Configuration Example
# Copy this file to .env and fill in values for your deployment.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask Backend
# ------------------------------------------------------------------------------

# Port the Flask/Gunicorn server listens on.
# Render sets this automatically; do not override it on Render.
PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
# Set to the Render static site URL once deployed (e.g. https://your-app.onrender.com).
# Leave blank to restrict to localhost only (local development default).
FRONTEND_URL=
