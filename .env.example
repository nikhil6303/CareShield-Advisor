# ==============================================================================
# CareShield Advisor - Environment Configuration Example
# Copy this file to .env and fill in values for your deployment.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask Backend
# ------------------------------------------------------------------------------

# Port the Flask/Gunicorn server listens on.
# Render sets this automatically; do not override it on Render.
PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
# Set to the Render static site URL once deployed (e.g. https://your-app.onrender.com).
# Leave blank to restrict to localhost only (local development default).
FRONTEND_URL=

# ------------------------------------------------------------------------------
# AI Explanation Service (Ollama / Qwen3 1.7B)
# ------------------------------------------------------------------------------

# Enable or disable the Qwen3 AI explanation feature.
# Set to false for initial cloud deployments where Ollama is not configured.
# The XGBoost prediction and SHAP explanations continue to work regardless.
# Set to true only when a reachable, secured Ollama instance is available.
OLLAMA_ENABLED=false

# URL of the Ollama inference server.
# For local development with Ollama Desktop: http://localhost:11434
# For a private remote Ollama instance: use a private VPN/internal URL only.
# NEVER expose an unauthenticated Ollama endpoint to the public internet.
OLLAMA_HOST=http://localhost:11434

# Ollama model tag to use for AI explanations.
OLLAMA_MODEL=qwen3:1.7b

# Timeout (seconds) for each Ollama inference request.
OLLAMA_TIMEOUT=30

# Maximum number of tokens to generate per explanation.
OLLAMA_MAX_TOKENS=450

# ------------------------------------------------------------------------------
# AI Explanation Rate Limiting (no external dependencies required)
# ------------------------------------------------------------------------------

# Maximum number of AI explanation requests allowed per rate window.
AI_RATE_LIMIT=10

# Rate limit window duration in seconds.
AI_RATE_WINDOW=60
